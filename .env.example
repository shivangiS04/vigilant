# AWS credentials (Bedrock + Lambda)
AWS_ACCESS_KEY_ID=your_key_here
AWS_SECRET_ACCESS_KEY=your_secret_here
AWS_DEFAULT_REGION=us-east-1

# PostgreSQL (leave blank to use SQLite for local dev)
DATABASE_URL=postgresql://postgres:vigilant@localhost:5432/vigilant

# Ring API — set RING_USE_SIMULATOR=false to use real Ring
RING_USE_SIMULATOR=true
RING_EMAIL=your-ring-email@gmail.com
RING_PASSWORD=your-ring-password
RING_POLL_INTERVAL=180

# Alexa integration — set ALEXA_ENABLED=true once Lambda is deployed
ALEXA_ENABLED=false
ALEXA_LAMBDA_FUNCTION=vigilant-alexa-announcer

# App
HOME_ID=home_001
