# AWS credentials (Bedrock + Lambda)
AWS_ACCESS_KEY_ID=your_key_here
AWS_SECRET_ACCESS_KEY=your_secret_here
AWS_DEFAULT_REGION=us-east-1

# PostgreSQL (leave blank to use SQLite for local dev)
DATABASE_URL=

# Ring Partner API. Keep the three Ring-issued values on the backend only.
RING_INTEGRATION_MODE=official
RING_CLIENT_ID=
RING_CLIENT_SECRET=
RING_HMAC_SIGNING_KEY=
# Generate with Fernet.generate_key(); encrypts customer access/refresh tokens at rest.
RING_TOKEN_ENCRYPTION_KEY=
# Generate with secrets.token_urlsafe(32); must remain stable across backend instances.
RING_SESSION_SECRET=
RING_COOKIE_SECURE=false

# Vigilant-side account used to securely claim Ring's one-way account-link nonce.
VIGILANT_ACCOUNT_EMAIL=
VIGILANT_ACCOUNT_PASSWORD_HASH=

# Alexa integration — set ALEXA_ENABLED=true once Lambda is deployed
ALEXA_ENABLED=false
ALEXA_LAMBDA_FUNCTION=vigilant-alexa-announcer

# App
HOME_ID=home_001
